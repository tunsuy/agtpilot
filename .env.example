# ==========================================
# agtpilot 核心配置文件 (SOTA Agent Stack)
# ==========================================

# 1. 大模型推理引擎配置 (LLM Providers)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 2. 业界顶级微虚拟机代码沙箱 (E2B Firecracker MicroVM)
# 获取地址: https://e2b.dev
E2B_API_KEY=

# 3. 业界顶级大模型神经与结构化搜索引擎
# Exa (神经网络语义搜索): https://exa.ai
EXA_API_KEY=
# Tavily (针对 Agent 优化的智能检索): https://tavily.com
TAVILY_API_KEY=

# 4. 业界顶级动态网页智能爬虫 (Firecrawl 反爬穿透与 Clean Markdown)
# 获取地址: https://firecrawl.dev
FIRECRAWL_API_KEY=

# 5. 服务端口与开发环境配置
PORT=3000
HOST=localhost

# 6. NextAuth (Auth.js v5) 认证中心
AUTH_SECRET=agtpilot-super-secret-jwt-key-2026
NEXTAUTH_URL=http://localhost:3000

# GitHub 真实 OAuth (获取地址: https://github.com/settings/developers)
# 回调授权 Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google 真实 OAuth (获取地址: https://console.cloud.google.com/apis/credentials)
# 回调授权 Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple 真实 OAuth (获取地址: https://developer.apple.com)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# 微信开放平台扫码登录 (获取地址: https://open.weixin.qq.com 网站应用)
# 回调授权 Callback URL: http://localhost:3000/api/auth/callback/wechat
AUTH_WECHAT_ID=
AUTH_WECHAT_SECRET=

# 模拟登录(沙盒体验)开关:生产 build 默认关闭
# true=强制开启(线上 Demo 演示用), false=强制关闭, 留空=仅开发环境开启
AUTH_ALLOW_MOCK=

# 7. 子 agent (plugin-subagent: 只读检索子 agent, docs/design/subagent-plugin-spec.md)
# 总开关: 0 = 不注册 research_subagent 工具(行为回到今天)
AGTPILOT_SUBAGENT=1
# 子循环步数上限(钳制 2..20)
AGTPILOT_SUBAGENT_MAX_STEPS=8
# 单次子 run token 自记账上限(0 = 不限)
AGTPILOT_SUBAGENT_MAX_TOKENS=60000
# 墙钟超时 ms(下限 30000)
AGTPILOT_SUBAGENT_TIMEOUT_MS=180000
# 并发信号量(钳制 1..8),超限排队不拒绝
AGTPILOT_SUBAGENT_MAX_CONCURRENT=4
# 子 agent 专用模型(留空继承 AGTPILOT_FAST_PROVIDER / AGTPILOT_FAST_MODEL)
AGTPILOT_SUBAGENT_PROVIDER=
AGTPILOT_SUBAGENT_MODEL=
# final report 字符上限(超限截断并标 truncated)
AGTPILOT_SUBAGENT_REPORT_LIMIT=8000
# 只读白名单覆盖(逗号分隔;留空用内置名单,仍受注册表 readOnly 声明硬校验)
AGTPILOT_SUBAGENT_WHITELIST=
# MCP 服务器白名单(逗号分隔服务器名)。双钥匙:仅白名单服务器中「自身声明只读
# (annotations.readOnlyHint)」的工具进入子 agent。留空 = 内置默认(github_mcp,
# huggingface,openalex,alphaxiv,deepwiki 检索类连接器;行情类依红线不开);
# off = 全关(子 agent 不使用任何 MCP 工具)。
# 注:web 宿主在留空时不直接用内置默认,而是按用户自动注入「已连接 ∩ 连接器目录
# subagentOpen 标记」(mcp-connectors.ts 目录级评审);显式设置本变量(含 off)则 env 优先。
AGTPILOT_SUBAGENT_MCP_SERVERS=
# MCP 逃生口(逗号分隔工具名前缀):无 annotations 注解的服务器用,不要求 readOnly 声明。
# 留空 = 内置默认(mcp_deepwiki_,mcp_newsnow_ —— 2026-10-14 经 annotations-report.mjs
# 实测全部工具为只读后列入);off = 全关。
AGTPILOT_SUBAGENT_MCP_ALLOW_TOOLS=

# 8. MCP 输出治理 (plugin-mcp: 层1 源头裁剪, docs/design/token-consumption-and-tool-loading.md §9.3)
# MCP 工具返回的统一字符上限(客户端侧裁剪,业界锚 Claude Code MAX_MCP_OUTPUT_TOKENS)。
# 默认 12000;0 = 关闭(原样透传,回退内核 16KB 统一截断)。
# per-server 收紧规则在代码内(plugin-mcp/src/output-cap.ts):deepwiki 8000、
# github_mcp JSON 字段压缩(单字符串 400)。所有裁剪带显式标记,不静默截断。
AGTPILOT_MCP_OUTPUT_LIMIT=12000

# ---- GitHub 连接器「设备码授权」通道(可选,推荐配置) ----
# GitHub 授权服务器不支持动态客户端注册(DCR),回跳式一键授权又要求 https 回调地址;
# 设备码授权(gh CLI 同款,OAuth 2.0 Device Grant)无回调、不挑部署形态(http/内网可用)。
# 配置步骤:github.com/settings/developers → New OAuth App(回调 URL 随意填占位,
# 设备码流程用不到)→ App 设置页勾选 Enable Device Flow → 生成 Client Secret。
# 两个变量齐备后,连接器中心 GitHub 卡片出现「设备码授权」按钮;未配置自动隐藏,
# 粘贴 Fine-grained PAT 的通道不受影响。
# Token 有效期:GitHub 对 2026-08-14 前创建的 App 默认发长效 token;之后新建的 App
# 默认发短期 token(access 8h + refresh 6 个月单次轮换)。本项目已请求 offline_access
# 并在任务派发/重启预热/手动重连前自动续期(ensureDeviceTokenFresh),用户体验等价
# 于不过期(免换 key)——注册 App 时 expiring tokens 开或关都能正常工作。
AGTPILOT_GITHUB_OAUTH_CLIENT_ID=
AGTPILOT_GITHUB_OAUTH_SECRET=
# 授权 scope(空格分隔,可选);默认 repo read:org read:user user:email workflow offline_access
# (基础部分与官方 github-mcp-server README 设备码示例一致;offline_access 换 refresh token 供自动续期)
# AGTPILOT_GITHUB_OAUTH_SCOPE=
