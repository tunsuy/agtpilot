# ==========================================
# agtpilot 核心配置文件 (SOTA Agent Stack)
# ==========================================

# 1. 大模型推理引擎配置 (LLM Providers)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 2. 业界顶级微虚拟机代码沙箱 (E2B Firecracker MicroVM)
# 获取地址: https://e2b.dev
E2B_API_KEY=

# 3. 业界顶级大模型神经与结构化搜索引擎
# Exa (神经网络语义搜索): https://exa.ai
EXA_API_KEY=
# Tavily (针对 Agent 优化的智能检索): https://tavily.com
TAVILY_API_KEY=

# 4. 业界顶级动态网页智能爬虫 (Firecrawl 反爬穿透与 Clean Markdown)
# 获取地址: https://firecrawl.dev
FIRECRAWL_API_KEY=

# 5. 服务端口与开发环境配置
PORT=3000
HOST=localhost

# 6. NextAuth (Auth.js v5) 认证中心
AUTH_SECRET=agtpilot-super-secret-jwt-key-2026
NEXTAUTH_URL=http://localhost:3000

# GitHub 真实 OAuth (获取地址: https://github.com/settings/developers)
# 回调授权 Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google 真实 OAuth (获取地址: https://console.cloud.google.com/apis/credentials)
# 回调授权 Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple 真实 OAuth (获取地址: https://developer.apple.com)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# 微信开放平台扫码登录 (获取地址: https://open.weixin.qq.com 网站应用)
# 回调授权 Callback URL: http://localhost:3000/api/auth/callback/wechat
AUTH_WECHAT_ID=
AUTH_WECHAT_SECRET=

# 模拟登录(沙盒体验)开关:生产 build 默认关闭
# true=强制开启(线上 Demo 演示用), false=强制关闭, 留空=仅开发环境开启
AUTH_ALLOW_MOCK=

# 7. 子 agent (plugin-subagent: 只读检索子 agent, docs/design/subagent-plugin-spec.md)
# 总开关: 0 = 不注册 research_subagent 工具(行为回到今天)
AGTPILOT_SUBAGENT=1
# 子循环步数上限(钳制 2..20)
AGTPILOT_SUBAGENT_MAX_STEPS=8
# 单次子 run token 自记账上限(0 = 不限)
AGTPILOT_SUBAGENT_MAX_TOKENS=60000
# 墙钟超时 ms(下限 30000)
AGTPILOT_SUBAGENT_TIMEOUT_MS=180000
# 并发信号量(钳制 1..8),超限排队不拒绝
AGTPILOT_SUBAGENT_MAX_CONCURRENT=4
# 子 agent 专用模型(留空继承 AGTPILOT_FAST_PROVIDER / AGTPILOT_FAST_MODEL)
AGTPILOT_SUBAGENT_PROVIDER=
AGTPILOT_SUBAGENT_MODEL=
# final report 字符上限(超限截断并标 truncated)
AGTPILOT_SUBAGENT_REPORT_LIMIT=8000
# 只读白名单覆盖(逗号分隔;留空用内置名单,仍受注册表 readOnly 声明硬校验)
AGTPILOT_SUBAGENT_WHITELIST=
# MCP 服务器白名单(逗号分隔服务器名,如 deepwiki,github_mcp)。
# 双钥匙:仅白名单服务器中「自身声明只读(annotations.readOnlyHint)」的工具进入子 agent。
# 留空 = 子 agent 不使用任何 MCP 工具(默认,行为同旧版)。
AGTPILOT_SUBAGENT_MCP_SERVERS=
# MCP 逃生口(逗号分隔工具名前缀,如 mcp_newsnow_):用于无 annotations 注解的服务器,
# 命中前缀的工具不要求 readOnly 声明,由部署者自行确认只读并担责。留空 = 不启用。
AGTPILOT_SUBAGENT_MCP_ALLOW_TOOLS=
