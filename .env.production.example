# ==========================================
# AgtPilot 生产环境配置模板 (.env.production)
# ==========================================

PORT=3000
NODE_ENV=production

# NextAuth (Auth.js v5) 认证中心
AUTH_SECRET=agtpilot-super-secret-jwt-key-2026
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 微信公众号（个人订阅号）配置
WECHAT_QR_URL=/wechat-qr.png
WECHAT_TOKEN=agtpilot_secure_token_2026
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 大模型推理引擎 (选填)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 微虚拟机与搜索引擎 (选填)
E2B_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
