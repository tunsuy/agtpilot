# ==========================================
# AgtPilot 生产环境配置模板 (.env.production)
# ==========================================

PORT=3000
NODE_ENV=production

# NextAuth (Auth.js v5) 认证中心
AUTH_SECRET=agtpilot-super-secret-jwt-key-2026
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 微信公众号（个人订阅号）配置
WECHAT_QR_URL=/wechat-qr.png
WECHAT_TOKEN=agtpilot_secure_token_2026
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 大模型推理引擎 (选填)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 微虚拟机与搜索引擎 (选填)
E2B_API_KEY=
# 自建 E2B:控制面/流量地址 + 模板(留空则走官方云服务)
E2B_DOMAIN=
E2B_API_URL=
E2B_SANDBOX_URL=
E2B_TEMPLATE=
E2B_TIMEOUT_MS=
E2B_IDLE_TTL_MS=
E2B_IDLE_ACTION=pause
E2B_ALLOW_INTERNET_ACCESS=
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# 生产环境显式关闭模拟登录通道(默认已关闭,此项为双保险)
AUTH_ALLOW_MOCK=false
